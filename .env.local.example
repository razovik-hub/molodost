# Yandex Cloud — секреты ассистента
# СКОПИРУЙ этот файл в `.env.local` (без `.example`) и заполни.
# `.env.local` в .gitignore — в репозиторий не попадёт.

# API-ключ сервисного аккаунта molodost-assistant
# (выпустили в Yandex Cloud → IAM → Сервисные аккаунты → API-ключи)
YANDEX_API_KEY=AQVN...

# ID каталога Yandex Cloud (folder ID, не секрет — но удобно держать рядом)
# Берётся из URL консоли: /folders/<FOLDER_ID>/...
YANDEX_FOLDER_ID=b1gskca1ipbfi2sn245m

# ID сервисного аккаунта (на странице аккаунта, начинается с `aje...`)
YANDEX_SERVICE_ACCOUNT_ID=aje...

# URL бэкенда ассистента — куда виджет на сайте шлёт запросы.
# Локально — наш dev-server. В production — URL Yandex Cloud Function.
# С префиксом PUBLIC_, чтобы Astro прокидывал его в браузер. Это не секрет.
PUBLIC_ASSISTANT_API=http://localhost:8788/api/chat

# Telegram-бот для уведомлений о бронях (заполним позже)
# Создаётся через @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
