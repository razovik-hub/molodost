---
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const {
  title = 'Алхимия молодости: 7 ступеней — авторский курс Марины Баяндиной',
  description = 'Авторский курс Марины Баяндиной по антивозрастной нутрициологии. 7 ступеней — от биохимии клетки до сияния кожи. Системно, врачебно, премиум.',
} = Astro.props;

// helper для ассетов: нормализует путь с учётом base (для GH Pages base=/molodost)
const asset = (p: string) => {
  const b = import.meta.env.BASE_URL.replace(/\/$/, '');
  return `${b}/${p.replace(/^\//, '')}`;
};

// URL бэкенда ассистента. Пусто → виджет работает в режиме заглушек.
const ASSISTANT_API = import.meta.env.PUBLIC_ASSISTANT_API || '';
---

<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="header" id="header">
    <div class="container header-inner">
      <a class="logo" href="#top" aria-label="Алхимия молодости: 7 ступеней">
        <span class="logo-mark">A</span>
        <span class="logo-text">Алхимия молодости</span>
      </a>
      <nav class="nav" id="nav">
        <a href="#steps">Программа</a>
        <a href="#audience">Для кого</a>
        <a href="#expert">Эксперт</a>
        <a href="#tariffs">Участие</a>
      </nav>
      <button class="btn btn-gold header-cta js-open-assistant">Забронировать место</button>
      <button class="burger" id="burger" aria-label="Меню"><span></span><span></span><span></span></button>
    </div>
  </header>

  <main id="top">
    <slot />
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-top">
        <div>
          <a class="logo" href="#top">
            <span class="logo-num">7</span>
            <span class="logo-text">ступеней</span>
            <span class="logo-sub">молодости</span>
          </a>
          <p class="footer-tag">«Алхимия молодости: 7 ступеней» — авторский курс Марины Баяндиной по антивозрастной нутрициологии и системному подходу к здоровью.</p>
        </div>
        <nav class="footer-links">
          <a href="https://instagram.com/dr.robertovna" target="_blank" rel="noopener">Instagram</a>
          <a href="https://t.me/dr_robertovna" target="_blank" rel="noopener">Telegram</a>
          <a href="https://bayandina.ru" target="_blank" rel="noopener">bayandina.ru</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <span>© 2026 «Алхимия молодости». Все права защищены.</span>
        <span>Информация на сайте не является медицинской консультацией или диагнозом.</span>
      </div>
    </div>
  </footer>

  <!-- ИИ-ассистент: чат + голос (YandexGPT + SpeechKit). Бэкенд — PUBLIC_ASSISTANT_API. -->
  <button class="assistant-launcher" id="assistant-launcher">
    <span class="spark">✦</span> Ассистент курса
  </button>
  <section class="assistant-panel" id="assistant-panel" aria-label="Ассистент курса">
    <header class="assistant-head">
      <div class="ava">A</div>
      <div>
        <div class="ttl">Ассистент курса</div>
        <div class="sub">«Алхимия молодости: 7 ступеней»</div>
      </div>
      <button class="snd" id="assistant-sound" type="button" aria-label="Озвучивать ответы" aria-pressed="false"></button>
      <button class="close" id="assistant-close" aria-label="Закрыть">×</button>
    </header>
    <div class="assistant-body" id="assistant-body">
      <div class="msg bot">Здравствуйте! Я ассистент курса Марины Баяндиной. Помогу разобраться в программе, подобрать тариф и забронировать место. Что вас интересует?</div>
    </div>
    <div class="chips" id="assistant-chips">
      <button class="chip" data-intent="program">Расскажите о программе</button>
      <button class="chip" data-intent="book">Забронировать место</button>
      <button class="chip" data-intent="pay">Прислать ссылку на оплату</button>
    </div>
    <div class="assistant-input">
      <button class="mic" id="assistant-mic" type="button" aria-label="Голосовой ввод">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><line x1="12" y1="18" x2="12" y2="22"/></svg>
      </button>
      <input type="text" id="assistant-text" placeholder="Напишите сообщение…" />
      <button id="assistant-send" aria-label="Отправить">➤</button>
    </div>
    <div class="assistant-note" id="assistant-note">Превью-режим. Скоро ассистент будет отвечать вживую.</div>
  </section>

  <script define:vars={{ ASSISTANT_API }}>
    // Шапка: фон при скролле
    const header = document.getElementById('header');
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Бургер-меню
    const burger = document.getElementById('burger');
    burger?.addEventListener('click', () => header.classList.toggle('menu-open'));
    document.querySelectorAll('#nav a').forEach((a) =>
      a.addEventListener('click', () => header.classList.remove('menu-open'))
    );

    // Появление при скролле
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
      { threshold: 0.12 }
    );
    document.querySelectorAll('[data-animate], .step-row').forEach((el) => io.observe(el));

    // ─── Ассистент ───
    const panel = document.getElementById('assistant-panel');
    const launcher = document.getElementById('assistant-launcher');
    const body = document.getElementById('assistant-body');
    const note = document.getElementById('assistant-note');
    const chips = document.getElementById('assistant-chips');
    const input = document.getElementById('assistant-text');
    const sendBtn = document.getElementById('assistant-send');
    const micBtn = document.getElementById('assistant-mic');
    const soundBtn = document.getElementById('assistant-sound');

    const LIVE = !!ASSISTANT_API; // подключен ли бэкенд (есть PUBLIC_ASSISTANT_API)
    if (LIVE) note.textContent = 'Ассистент отвечает по теме курса — текстом или голосом. Может ошибиться, детали уточняйте.';

    // Иконки-глифы (inline SVG) для динамических элементов
    const SVG_SPEAK = '<svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10v4h3l4 3V7L6 10H3z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg>';
    const SVG_SOUND_ON = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10v4h3l4 3V7L6 10H3z"/><path d="M15 8.5a5 5 0 0 1 0 7"/><path d="M17.6 6a8 8 0 0 1 0 12"/></svg>';
    const SVG_SOUND_OFF = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10v4h3l4 3V7L6 10H3z"/><line x1="15" y1="9" x2="20" y2="14"/><line x1="20" y1="9" x2="15" y2="14"/></svg>';

    // Голос недоступен без бэкенда — в fallback-режиме прячем кнопки
    if (!LIVE) { micBtn?.remove(); soundBtn?.remove(); }

    const openA = () => { panel.classList.add('open'); launcher.style.display = 'none'; input.focus(); };
    const closeA = () => { stopAudio(); teardownRec(); panel.classList.remove('open'); launcher.style.display = ''; input.placeholder = 'Напишите сообщение…'; };
    launcher.addEventListener('click', openA);
    document.getElementById('assistant-close')?.addEventListener('click', closeA);
    document.querySelectorAll('.js-open-assistant').forEach((b) => b.addEventListener('click', openA));

    const history = []; // [{role:'user'|'assistant', text}]
    let pending = false;

    // ── Сообщения ──
    const userBubble = (text) => {
      const m = document.createElement('div');
      m.className = 'msg user';
      m.textContent = text;
      body.appendChild(m);
      body.scrollTop = body.scrollHeight;
      return m;
    };
    const botBubble = (text) => {
      const m = document.createElement('div');
      m.className = 'msg bot';
      const t = document.createElement('span');
      t.className = 'msg-text';
      t.textContent = text;
      m.appendChild(t);
      if (LIVE) m.appendChild(makeSpeaker(text));
      body.appendChild(m);
      body.scrollTop = body.scrollHeight;
      return m;
    };
    const pushTyping = () => {
      const m = document.createElement('div');
      m.className = 'msg bot msg-typing';
      body.appendChild(m);
      body.scrollTop = body.scrollHeight;
      return m;
    };
    const makeSpeaker = (text) => {
      const b = document.createElement('button');
      b.className = 'msg-speak';
      b.type = 'button';
      b.setAttribute('aria-label', 'Прослушать');
      b.innerHTML = SVG_SPEAK;
      b.addEventListener('click', () => speak(text, b));
      return b;
    };

    const setBusy = (on) => {
      pending = on;
      sendBtn.disabled = on;
      input.disabled = on;
      if (micBtn) micBtn.disabled = on;
      input.placeholder = on ? 'Подождите…' : 'Напишите сообщение…';
    };

    // ── Озвучка ответов (TTS → WAV) ──
    let autoSpeak = LIVE && localStorage.getItem('molodost_voice') === '1';
    let voiceTurn = false; // текущий вопрос задан голосом → ответ озвучиваем
    const ttsCache = new Map(); // text → objectURL (не пере-синтезируем одно и то же)
    let curAudio = null, curBtn = null;

    const renderSound = () => {
      if (!soundBtn) return;
      soundBtn.classList.toggle('on', autoSpeak);
      soundBtn.setAttribute('aria-pressed', String(autoSpeak));
      soundBtn.title = autoSpeak ? 'Озвучка ответов включена' : 'Озвучка ответов выключена';
      soundBtn.innerHTML = autoSpeak ? SVG_SOUND_ON : SVG_SOUND_OFF;
    };
    const setAutoSpeak = (v, persist = true) => {
      autoSpeak = v;
      if (persist) localStorage.setItem('molodost_voice', v ? '1' : '0');
      renderSound();
    };
    soundBtn?.addEventListener('click', () => { setAutoSpeak(!autoSpeak); if (!autoSpeak) stopAudio(); });
    renderSound();

    function stopAudio() {
      if (curAudio) { try { curAudio.pause(); } catch {} }
      if (curBtn) curBtn.classList.remove('playing');
      curAudio = null; curBtn = null;
    }

    async function speak(text, btn) {
      if (!LIVE || !text) return;
      // повторный тап по играющей реплике — стоп
      if (curBtn === btn && curAudio && !curAudio.paused) { stopAudio(); return; }
      stopAudio();
      btn?.classList.add('loading');
      try {
        let url = ttsCache.get(text);
        if (!url) {
          const res = await fetch(ASSISTANT_API, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'tts', text }),
          });
          const data = await res.json();
          if (!res.ok || data.error || !data.audio) { btn?.classList.remove('loading'); return; }
          url = URL.createObjectURL(b64ToBlob(data.audio, data.mime || 'audio/wav'));
          ttsCache.set(text, url);
        }
        btn?.classList.remove('loading');
        const a = new Audio(url);
        curAudio = a; curBtn = btn || null;
        btn?.classList.add('playing');
        a.onended = () => { if (curAudio === a) stopAudio(); };
        a.onerror = () => { if (curAudio === a) stopAudio(); };
        await a.play().catch(() => stopAudio());
      } catch (e) {
        btn?.classList.remove('loading');
      }
    }

    // ── Голосовой ввод (микрофон → PCM16 16k → STT) ──
    let recording = false, mediaStream = null, audioCtx = null, procNode = null, srcNode = null, recChunks = [], maxTimer = null;

    async function startRec() {
      if (recording || pending) return;
      try {
        mediaStream = await navigator.mediaDevices.getUserMedia({
          audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true },
        });
      } catch (e) {
        botBubble('Не получилось включить микрофон. Разрешите доступ в настройках браузера — или просто напишите текстом.');
        return;
      }
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      try { await audioCtx.resume(); } catch {}
      srcNode = audioCtx.createMediaStreamSource(mediaStream);
      procNode = audioCtx.createScriptProcessor(4096, 1, 1);
      recChunks = [];
      procNode.onaudioprocess = (e) => { recChunks.push(new Float32Array(e.inputBuffer.getChannelData(0))); };
      srcNode.connect(procNode);
      procNode.connect(audioCtx.destination); // выходной буфер пуст → в колонки идёт тишина
      recording = true;
      micBtn.classList.add('rec');
      input.placeholder = 'Слушаю… нажмите, чтобы остановить';
      setAutoSpeak(true, false); // говорим голосом → хотим слышать ответ (без записи в localStorage)
      maxTimer = setTimeout(stopRec, 25000); // синхронный STT — до 30 c
    }

    function teardownRec() {
      if (maxTimer) { clearTimeout(maxTimer); maxTimer = null; }
      recording = false;
      micBtn?.classList.remove('rec', 'busy');
      try { procNode && procNode.disconnect(); } catch {}
      try { srcNode && srcNode.disconnect(); } catch {}
      try { mediaStream && mediaStream.getTracks().forEach((t) => t.stop()); } catch {}
      try { audioCtx && audioCtx.close(); } catch {}
      procNode = srcNode = mediaStream = audioCtx = null;
    }

    async function stopRec() {
      if (!recording) return;
      const inRate = audioCtx.sampleRate;
      const flat = mergeChunks(recChunks);
      recChunks = [];
      teardownRec();
      input.placeholder = 'Напишите сообщение…';
      if (flat.length < inRate * 0.3) return; // < 0.3 c — случайный тап, игнорируем

      const pcm16 = floatToPcm16(downsample(flat, inRate, 16000));
      const b64 = bufToBase64(pcm16.buffer);

      micBtn.classList.add('busy');
      input.placeholder = 'Распознаю…';
      try {
        const res = await fetch(ASSISTANT_API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'stt', audio: b64, rate: 16000 }),
        });
        const data = await res.json();
        micBtn.classList.remove('busy');
        input.placeholder = 'Напишите сообщение…';
        if (!res.ok || data.error || !data.text) {
          input.placeholder = 'Не расслышала. Повторите или напишите текстом.';
          setTimeout(() => { if (!recording) input.placeholder = 'Напишите сообщение…'; }, 2600);
          return;
        }
        voiceTurn = true;
        ask(data.text);
      } catch (e) {
        micBtn.classList.remove('busy');
        input.placeholder = 'Связь прервалась. Напишите текстом.';
        setTimeout(() => { if (!recording) input.placeholder = 'Напишите сообщение…'; }, 2600);
      }
    }

    micBtn?.addEventListener('click', () => (recording ? stopRec() : startRec()));

    // ── PCM-утилиты ──
    function mergeChunks(arr) {
      let len = 0; for (const c of arr) len += c.length;
      const out = new Float32Array(len);
      let o = 0; for (const c of arr) { out.set(c, o); o += c.length; }
      return out;
    }
    function downsample(buf, inRate, outRate) {
      if (outRate >= inRate) return buf;
      const ratio = inRate / outRate;
      const outLen = Math.floor(buf.length / ratio);
      const out = new Float32Array(outLen);
      for (let i = 0; i < outLen; i++) {
        const start = Math.floor(i * ratio), end = Math.min(buf.length, Math.floor((i + 1) * ratio));
        let sum = 0, n = 0;
        for (let j = start; j < end; j++) { sum += buf[j]; n++; }
        out[i] = n ? sum / n : 0;
      }
      return out;
    }
    function floatToPcm16(buf) {
      const out = new Int16Array(buf.length);
      for (let i = 0; i < buf.length; i++) {
        const s = Math.max(-1, Math.min(1, buf[i]));
        out[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
      }
      return out;
    }
    function bufToBase64(ab) {
      const bytes = new Uint8Array(ab);
      let bin = '';
      for (let i = 0; i < bytes.length; i += 0x8000) bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
      return btoa(bin);
    }
    function b64ToBlob(b64, mime) {
      const bin = atob(b64);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return new Blob([bytes], { type: mime });
    }

    const FALLBACKS = {
      'Расскажите о программе': 'Курс — 7 ступеней: код старения, обмен веществ, гормоны, сердце-сосуды, опора тела, ясный ум, сияние кожи. Каждая — блок с теорией и практикой от Марины. Подобрать тариф?',
      'Забронировать место': 'Чтобы забронировать — напишите имя и Telegram-юзернейм или телефон. Я зафиксирую за вами место.',
      'Прислать ссылку на оплату': 'Как только подтвердим тариф — пришлю персональную ссылку на оплату. Какой тариф вам ближе?',
    };

    async function ask(text) {
      if (pending) return;
      // После первой реплики прячем чипы — диалог получает всю высоту.
      if (chips) chips.style.display = 'none';
      userBubble(text);
      history.push({ role: 'user', text });

      // Fallback-режим: отвечаем по словарю
      if (!LIVE) {
        const reply = FALLBACKS[text] || 'Ассистент скоро заработает в полную силу. А пока — оставьте имя и Telegram, и Марина свяжется с вами лично.';
        setTimeout(() => { botBubble(reply); history.push({ role: 'assistant', text: reply }); }, 350);
        return;
      }

      // Live-режим: реальный запрос в backend
      setBusy(true);
      const typingMsg = pushTyping();

      try {
        const res = await fetch(ASSISTANT_API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'chat', history: history.slice(0, -1), message: text }),
        });
        const data = await res.json();
        typingMsg.remove();

        if (!res.ok || data.error) {
          botBubble('Что-то пошло не так у меня на связи. Попробуйте ещё раз — или оставьте имя и Telegram, я передам Марине.');
          return;
        }
        const el = botBubble(data.reply);
        history.push({ role: 'assistant', text: data.reply });
        if (autoSpeak || voiceTurn) speak(data.reply, el.querySelector('.msg-speak'));
        voiceTurn = false;
      } catch (e) {
        typingMsg.remove();
        botBubble('Не получилось связаться с сервером. Оставьте, пожалуйста, имя и Telegram — я передам Марине.');
      } finally {
        setBusy(false);
        input.focus();
      }
    }

    // Добавляем «прослушать» к стартовому приветствию (LIVE)
    if (LIVE) {
      body.querySelectorAll('.msg.bot').forEach((m) => {
        if (m.querySelector('.msg-speak')) return;
        const txt = m.textContent.trim();
        const span = document.createElement('span');
        span.className = 'msg-text';
        span.textContent = txt;
        m.textContent = '';
        m.appendChild(span);
        m.appendChild(makeSpeaker(txt));
      });
    }

    chips?.querySelectorAll('.chip').forEach((c) => c.addEventListener('click', () => ask(c.textContent)));

    const send = () => {
      const v = input.value.trim();
      if (!v) return;
      input.value = '';
      ask(v);
    };
    sendBtn?.addEventListener('click', send);
    input?.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !pending) send(); });
  </script>
</body>
</html>
